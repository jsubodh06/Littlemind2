{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Montessori toy or furniture product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "slug": { "type": "string", "maxLength": 150 },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "sku": { "type": "string", "maxLength": 50 },
        "stock": { "type": "number" },
        "ageRange": { "type": "string", "maxLength": 50 },
        "categoryId": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "isBestseller": { "type": "boolean" },
        "isNewLaunch": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 5000 },
        "whatsInside": { "type": "array" },
        "benefits": { "type": "array" },
        "images": { "type": "array" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "seoTitle": { "type": "string", "maxLength": 200 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "price", "stock", "ageRange", "categoryId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 1000 },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "slug"]
    },
    "AgeGroup": {
      "title": "AgeGroup",
      "description": "Age bracket for grouping toys",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 50 },
        "ageRange": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 300 },
        "color": { "type": "string", "maxLength": 30 },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "ageRange"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["placed", "packed", "shipped", "delivered", "cancelled"] },
        "trackingLink": { "type": "string", "maxLength": 500 },
        "paymentMethod": { "type": "string", "enum": ["cod", "razorpay_mock"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "orderNumber", "customerId", "items", "total", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount coupon",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 30 },
        "discountType": { "type": "string", "enum": ["percent", "flat"] },
        "discountValue": { "type": "number" },
        "minCartValue": { "type": "number" },
        "expiresAt": { "type": "string" },
        "isActive": { "type": "boolean" },
        "usageCount": { "type": "number" }
      },
      "required": ["id", "code", "discountType", "discountValue", "isActive"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Parent review or feedback quote",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 100 },
        "childAge": { "type": "string", "maxLength": 50 },
        "quote": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "number" },
        "location": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 1000 },
        "isFeatured": { "type": "boolean" }
      },
      "required": ["id", "authorName", "quote", "rating"]
    },
    "Faq": {
      "title": "Faq",
      "description": "Frequently asked question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string", "maxLength": 300 },
        "answer": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "order": { "type": "number" }
      },
      "required": ["id", "question", "answer"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 100 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "comment": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "productId", "customerName", "rating", "comment", "status"]
    },
    "Blog": {
      "title": "Blog",
      "description": "Montessori parenting article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 200 },
        "excerpt": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 20000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "author": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "publishedAt": { "type": "string" },
        "isPublished": { "type": "boolean" }
      },
      "required": ["id", "slug", "title", "content", "isPublished"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Site global settings and home CMS",
      "type": "object",
      "properties": {
        "announcementBarText": { "type": "string", "maxLength": 300 },
        "announcementBarLink": { "type": "string", "maxLength": 300 },
        "announcementBarActive": { "type": "boolean" },
        "heroBanners": { "type": "array" },
        "trustBadges": { "type": "array" },
        "shippingFee": { "type": "number" },
        "freeShippingThreshold": { "type": "number" },
        "contactEmail": { "type": "string", "maxLength": 120 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "instagramUrl": { "type": "string", "maxLength": 300 },
        "brandName": { "type": "string", "maxLength": 100 }
      }
    },
    "User": {
      "title": "User",
      "description": "User profile with role and addresses",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "maxLength": 120 },
        "name": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "addresses": { "type": "array" },
        "wishlist": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "role"]
    },
    "AdminDoc": {
      "title": "AdminDoc",
      "description": "Reference marker for verified admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "grantedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public catalog of Montessori toys and play furniture"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Store categories"
    },
    "/ageGroups/{ageGroupId}": {
      "schema": { "$ref": "#/entities/AgeGroup" },
      "description": "Age groupings and developmental stages"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Discount codes"
    },
    "/testimonials/{testimonialId}": {
      "schema": { "$ref": "#/entities/Testimonial" },
      "description": "Parent testimonials and reviews"
    },
    "/faqs/{faqId}": {
      "schema": { "$ref": "#/entities/Faq" },
      "description": "Frequently asked questions"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product rating submissions"
    },
    "/blogs/{blogId}": {
      "schema": { "$ref": "#/entities/Blog" },
      "description": "Montessori parenting blog articles"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Site global and home CMS settings"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles and customer details"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminDoc" },
      "description": "Admin authorization collection"
    }
  }
}
